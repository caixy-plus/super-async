<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.superasync</groupId>
    <artifactId>super-async</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>super-async</name>
    <description>通用异步任务调度平台</description>

    <modules>
        <module>super-async-sdk</module>
        <module>super-async-server</module>
        <module>super-async-benchmark</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <hutool.version>5.8.26</hutool.version>
        <flyway.version>10.10.0</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.superasync</groupId>
                <artifactId>super-async-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.superasync</groupId>
                <artifactId>super-async-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.superasync</groupId>
                <artifactId>super-async-benchmark</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
